{
  "name": "customize-am62a-reference-design",
  "version": "0.1.0",
  "private": true,
  "description": "Prebuilt parameterized-TSX configurator for five Texas Instruments EVMs",
  "type": "module",
  "scripts": {
    "download:ti-evm-references": "bun scripts/download-ti-evm-references.ts",
    "generate:ti-evm-references": "bun run download:ti-evm-references && bun scripts/generate-ti-evm-reference-definitions.ts",
    "prebuild:ti-evms": "bun scripts/prebuild-ti-evms.ts && bun scripts/prebuild-ti-evm-schematic-assets.ts && bun scripts/prebuild-board-details.ts",
    "rebuild:ti-evms": "bun run generate:ti-evm-references && bun run prebuild:ti-evms",
    "prebuild:board-details": "bun scripts/prebuild-board-details.ts",
    "dev": "vite",
    "build": "vite build",
    "test": "bun test --smol",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "dependencies": {
    "@tscircuit/3d-viewer": "https://pkg.pr.new/tscircuit/3d-viewer/@tscircuit/3d-viewer@07e36b9",
    "@tscircuit/pcb-viewer": "1.11.426",
    "@tscircuit/schematic-viewer": "2.0.100",
    "fflate": "0.8.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tscircuit/checks": "0.0.245",
    "@tscircuit/circuit-json-util": "0.0.120",
    "@tscircuit/math-utils": "0.0.38",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "altium-to-circuit-json": "https://pkg.pr.new/altium-to-circuit-json@9d3f8d3",
    "altiumts": "0.0.94",
    "bun-match-svg": "0.0.17",
    "bun-types": "1.4.2",
    "circuit-json": "0.0.525",
    "circuit-json-to-gltf": "0.0.152",
    "circuit-json-to-tscircuit": "https://pkg.pr.new/circuit-json-to-tscircuit@6245a57",
    "circuit-to-svg": "0.0.445",
    "fast-png": "8.0.0",
    "format-si-unit": "0.0.14",
    "poppygl": "0.0.34",
    "transformation-matrix": "3.1.0",
    "tscircuit": "https://pkg.pr.new/tscircuit/tscircuit@2ff3834",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  },
  "overrides": {
    "altiumts": "$altiumts",
    "@tscircuit/capacity-autorouter": "https://pkg.pr.new/@tscircuit/capacity-autorouter@8e1f62d"
  }
}
