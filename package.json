{
  "name": "customize-am62a-reference-design",
  "version": "0.1.0",
  "private": true,
  "description": "Prebuilt parameterized-TSX configurator for five Texas Instruments EVMs",
  "type": "module",
  "scripts": {
    "prepare:generated": "bun scripts/prepare-generated-assets.ts",
    "download:ti-evm-references": "bun scripts/download-ti-evm-references.ts",
    "generate:ti-evm-references": "bun run download:ti-evm-references && bun scripts/generate-ti-evm-reference-definitions.ts",
    "prebuild:ti-evms": "bun run prepare:generated && bun scripts/prebuild-ti-evms.ts && bun scripts/prebuild-ti-evm-schematic-assets.ts && bun scripts/prebuild-board-details.ts",
    "rebuild:ti-evms": "bun run generate:ti-evm-references && bun run prebuild:ti-evms",
    "prebuild:board-details": "bun scripts/prebuild-board-details.ts",
    "dev": "bun run prepare:generated && vite",
    "build": "bun run prepare:generated && vite build",
    "test": "bun run prepare:generated && bun test --smol",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "dependencies": {
    "@tscircuit/checks": "0.0.222",
    "@tscircuit/circuit-json-util": "0.0.116",
    "@tscircuit/core": "https://pkg.pr.new/tscircuit/core/@tscircuit/core@5dffffd",
    "@tscircuit/math-utils": "0.0.36",
    "@tscircuit/modelprinter": "0.0.8",
    "@tscircuit/pcb-viewer": "github:tscircuit/pcb-viewer#e4eab0f44a935cd0db9335adbd836daeed2977fa",
    "@tscircuit/props": "https://pkg.pr.new/tscircuit/props/@tscircuit/props@7715fdf",
    "@tscircuit/schematic-viewer": "2.0.99",
    "circuit-json": "0.0.506",
    "fflate": "0.8.3",
    "format-si-unit": "0.0.12",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@types/node": "24.5.2",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "@tscircuit/mm": "0.0.9",
    "@tscircuit/soup-util": "0.0.41",
    "altium-to-circuit-json": "github:tscircuit/altium-to-circuit-json#5cba48de9564ce5f0d91f57a103cd2924cc842a1",
    "altiumts": "github:tscircuit/altiumts#8db22cf449c7bf6584a968b4913be4e1bd4a93ad",
    "bun-match-svg": "0.0.17",
    "bun-types": "1.2.22",
    "circuit-json-to-tscircuit": "github:tscircuit/circuit-json-to-tscircuit#0b2d9ff87f18d4d64a838b70e9aec6454c90d8a",
    "circuit-to-svg": "0.0.432",
    "circuit-json-to-gltf": "0.0.133",
    "poppygl": "0.0.29",
    "transformation-matrix": "2.16.1",
    "typescript": "5.9.2",
    "vite": "7.1.7"
  },
  "patchedDependencies": {
    "circuit-json@0.0.506": "patches/circuit-json@0.0.506.patch",
    "@tscircuit/checks@0.0.222": "patches/@tscircuit%2Fchecks@0.0.222.patch",
    "@tscircuit/props@https://pkg.pr.new/tscircuit/props/@tscircuit/props@7715fdf": "patches/@tscircuit%2Fprops@https%3A%2F%2Fpkg.pr.new%2Ftscircuit%2Fprops%2F@tscircuit%2Fprops@7715fdf.patch"
  },
  "trustedDependencies": [
    "@tscircuit/pcb-viewer",
    "altium-to-circuit-json",
    "altiumts",
    "circuit-json-to-tscircuit"
  ]
}
