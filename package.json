{
  "name": "customize-am62a-reference-design",
  "version": "0.1.0",
  "private": true,
  "description": "Prebuilt parameterized-TSX configurator for five Texas Instruments EVMs",
  "type": "module",
  "scripts": {
    "download:ti-evm-references": "bun scripts/download-ti-evm-references.ts",
    "generate:ti-evm-references": "bun run download:ti-evm-references && bun scripts/generate-ti-evm-reference-definitions.ts",
    "prebuild:ti-evms": "bun scripts/prebuild-ti-evms.ts && bun scripts/prebuild-ti-evm-schematic-assets.ts && bun scripts/prebuild-board-details.ts",
    "rebuild:ti-evms": "bun run generate:ti-evm-references && bun run prebuild:ti-evms",
    "prebuild:board-details": "bun scripts/prebuild-board-details.ts",
    "dev": "vite",
    "build": "vite build",
    "test": "bun test --smol",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "dependencies": {
    "@tscircuit/capacity-autorouter": "0.0.962",
    "@tscircuit/checks": "0.0.243",
    "@tscircuit/circuit-json-util": "0.0.120",
    "@tscircuit/core": "0.0.2094",
    "@tscircuit/math-utils": "0.0.38",
    "@tscircuit/modelprinter": "0.0.8",
    "@tscircuit/pcb-viewer": "1.11.419",
    "@tscircuit/props": "0.0.688",
    "@tscircuit/schematic-viewer": "2.0.100",
    "circuit-json": "0.0.517",
    "fflate": "0.8.3",
    "format-si-unit": "0.0.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@tscircuit/mm": "0.0.9",
    "@tscircuit/soup-util": "0.0.41",
    "altium-to-circuit-json": "github:tscircuit/altium-to-circuit-json#f242487eb904e6ed5e6076dc1d4ce7eabd16c948",
    "altiumts": "0.0.87",
    "bun-match-svg": "0.0.17",
    "bun-types": "1.4.2",
    "circuit-json-to-tscircuit": "github:tscircuit/circuit-json-to-tscircuit#0b2d9ff87f18d4d64a838b70e9aec6454c90d8a",
    "circuit-to-svg": "0.0.441",
    "circuit-json-to-gltf": "0.0.145",
    "poppygl": "0.0.33",
    "transformation-matrix": "3.1.0",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  },
  "trustedDependencies": [
    "@tscircuit/capacity-autorouter",
    "altiumts",
    "circuit-json-to-tscircuit"
  ]
}
