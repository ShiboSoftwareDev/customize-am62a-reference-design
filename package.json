{
  "name": "customize-am62a-reference-design",
  "version": "0.1.0",
  "private": true,
  "description": "Instant prebuilt configurator for open-source TI BoosterPack designs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
