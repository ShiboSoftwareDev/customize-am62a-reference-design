{
  "name": "customize-am62a-reference-design",
  "version": "0.1.0",
  "private": true,
  "description": "Prebuilt configurator for complex Texas Instruments evaluation modules",
  "type": "module",
  "scripts": {
    "prepare:generated": "bun scripts/prepare-generated-assets.ts",
    "prebuild:ti-evms": "bun run prepare:generated && bun scripts/prebuild-ti-evms.ts",
    "dev": "bun run prepare:generated && vite",
    "build": "bun run prepare:generated && vite build",
    "test": "bun run prepare:generated && bun test",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "dependencies": {
    "@tscircuit/checks": "0.0.222",
    "@tscircuit/circuit-json-util": "0.0.116",
    "@tscircuit/core": "0.0.1993",
    "@tscircuit/pcb-viewer": "1.11.409",
    "@tscircuit/schematic-viewer": "2.0.98",
    "circuit-json": "0.0.506",
    "fflate": "0.8.3",
    "format-si-unit": "0.0.12",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@types/node": "24.5.2",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "altium-to-circuit-json": "0.0.70",
    "altiumts": "0.0.81",
    "bun-types": "1.2.22",
    "typescript": "5.9.2",
    "vite": "7.1.7"
  },
  "overrides": {
    "altiumts": "0.0.81"
  },
  "patchedDependencies": {
    "@tscircuit/props@0.0.668": "patches/@tscircuit%2Fprops@0.0.668.patch",
    "circuit-json@0.0.506": "patches/circuit-json@0.0.506.patch",
    "@tscircuit/checks@0.0.222": "patches/@tscircuit%2Fchecks@0.0.222.patch"
  }
}
