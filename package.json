{
  "name": "customize-am62a-reference-design",
  "version": "0.1.0",
  "private": true,
  "description": "Prebuilt parameterized-TSX configurator for four Sitara boards",
  "type": "module",
  "scripts": {
    "download:ti-evm-references": "bun scripts/download-ti-evm-references.ts",
    "generate:ti-evm-references": "bun run download:ti-evm-references && bun scripts/generate-ti-evm-reference-definitions.ts",
    "prebuild:ti-evms": "bun scripts/prebuild-ti-evms.ts && bun scripts/prebuild-ti-evm-schematic-assets.ts && bun scripts/prebuild-ti-evm-cad-scenes.ts && bun scripts/prebuild-board-details.ts",
    "prebuild:ti-evm-cad-scenes": "bun scripts/prebuild-ti-evm-cad-scenes.ts",
    "rebuild:ti-evms": "bun run generate:ti-evm-references && bun run prebuild:ti-evms",
    "prebuild:board-details": "bun scripts/prebuild-board-details.ts",
    "dev": "vite",
    "build": "vite build",
    "test": "bun test --smol",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=6144 tsc --noEmit --project tsconfig.typecheck.json",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "dependencies": {
    "@tscircuit/3d-viewer": "0.0.629",
    "@tscircuit/pcb-viewer": "1.11.440",
    "@tscircuit/schematic-viewer": "2.0.100",
    "fflate": "0.8.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@jscad/modeling": "2.13.0",
    "@tscircuit/checks": "0.0.266",
    "@tscircuit/circuit-json-util": "0.0.128",
    "@tscircuit/footprinter": "0.0.450",
    "@tscircuit/manifold-2d": "0.0.6",
    "@tscircuit/math-utils": "0.0.38",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "altium-to-circuit-json": "https://pkg.pr.new/tscircuit/altium-to-circuit-json@4819904",
    "altiumts": "0.0.87",
    "bun-match-svg": "0.0.17",
    "bun-types": "1.4.2",
    "circuit-json": "0.0.539",
    "circuit-json-to-connectivity-map": "0.0.33",
    "circuit-json-to-gltf": "0.0.163",
    "circuit-json-to-tscircuit": "0.0.95",
    "circuit-to-svg": "0.0.445",
    "fast-png": "8.0.0",
    "format-si-unit": "0.0.14",
    "jscad-planner": "0.0.19",
    "poppygl": "0.0.34",
    "transformation-matrix": "3.1.0",
    "tscircuit": "0.0.3043",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  },
  "overrides": {
    "altiumts": "$altiumts",
    "@tscircuit/copper-pour-solver": "https://pkg.pr.new/@tscircuit/copper-pour-solver@926d4aa"
  }
}
