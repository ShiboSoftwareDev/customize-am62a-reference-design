{
  "name": "customize-am62a-reference-design",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive conditional-TSX configurator for the TI SK-AM62A-LP reference design",
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel 'dev:*'",
    "dev:api": "bun --watch lib/server/dev-api.ts",
    "dev:web": "vite",
    "build": "vite build",
    "test": "bun test",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "dependencies": {
    "@tscircuit/core": "0.0.1993",
    "@tscircuit/circuit-json-util": "0.0.116",
    "@tscircuit/pcb-viewer": "1.11.409",
    "@tscircuit/schematic-viewer": "2.0.98",
    "circuit-json": "0.0.506",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@types/node": "24.5.2",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vercel/node": "5.3.24",
    "@vitejs/plugin-react": "5.0.4",
    "bun-types": "1.2.22",
    "typescript": "5.9.2",
    "vite": "7.1.7"
  },
  "patchedDependencies": {
    "@tscircuit/props@0.0.668": "patches/@tscircuit%2Fprops@0.0.668.patch",
    "circuit-json@0.0.506": "patches/circuit-json@0.0.506.patch",
    "@tscircuit/checks@0.0.222": "patches/@tscircuit%2Fchecks@0.0.222.patch"
  }
}
