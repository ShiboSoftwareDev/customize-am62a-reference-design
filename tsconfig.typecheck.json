{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": {
      "lib/generated/am62a-board": ["./types/am62a-board.d.ts"],
      "app/*": ["./app/*"],
      "lib/*": ["./lib/*"],
      "tests/*": ["./tests/*"],
      "@tscircuit/pcb-viewer": ["./types/tscircuit-pcb-viewer.d.ts"],
      "@tscircuit/schematic-viewer": ["./types/tscircuit-schematic-viewer.d.ts"],
      "circuit-json": ["./types/circuit-json.d.ts"]
    }
  },
  "include": ["app", "lib", "scripts", "tests", "types", "vite.config.ts"]
}
