{
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/evaluate.ts": {
      "maxDuration": 300,
      "memory": 2048,
      "includeFiles": "lib/generated/am62a-board.tsx"
    },
    "api/source.ts": {
      "maxDuration": 30,
      "includeFiles": "lib/generated/am62a-board.tsx"
    }
  }
}
