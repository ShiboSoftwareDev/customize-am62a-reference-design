{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "bunVersion": "1.4.x",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/server.ts": {
      "maxDuration": 300,
      "memory": 2048,
      "includeFiles": "lib/generated/am62a-board-source.txt"
    }
  },
  "rewrites": [
    { "source": "/api/evaluate", "destination": "/api/server/evaluate" },
    { "source": "/api/source", "destination": "/api/server/source" }
  ]
}
